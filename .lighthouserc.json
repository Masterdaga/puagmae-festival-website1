{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/about",
        "http://localhost:3000/Registration",
        "http://localhost:3000/gallery"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": { "assertions": {} },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

